{
  "name": "skinboost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write index.html src tests vite.config.mjs",
    "format:check": "prettier --check index.html src tests vite.config.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "gsap": "^3.15.0",
    "three": "^0.185.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
